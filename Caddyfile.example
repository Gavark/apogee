# Caddyfile example: copy to `Caddyfile` and edit with your domain.
# `Caddyfile` is gitignored so your real config stays local.
# Set ORIGIN=https://your-domain.example.com in .env to match.
your-domain.example.com {
    encode gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:3000
}
